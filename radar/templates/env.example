# ─── PIX (Brasil) ────────────────────────────────────────────────────────
# Sem PIX_KEY o app roda em sandbox funcional. Preencha para receber de verdade.
PIX_KEY=
PIX_BENEFICIARY_NAME=Roberto Rodrigues
PIX_CITY=Fortaleza

# ─── PAYPAL (internacional) ──────────────────────────────────────────────
# https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox

# ─── DEPLOY ──────────────────────────────────────────────────────────────
# https://vercel.com/account/tokens
VERCEL_TOKEN=

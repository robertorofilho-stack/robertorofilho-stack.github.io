#!/usr/bin/env bash
# SOBERANIA DO MOTOR — portão do git.
# Ativado por: git config core.hooksPath .claude/git-hooks   (o bootstrap.sh faz isso)
#
# Quem commita é o Claude Code (variável CLAUDECODE no ambiente) → regrava o manifesto de
# integridade e deixa passar. Qualquer outro (Codex, ChatGPT, edição manual) que toque arquivo
# do motor → bloqueado. Sobrescrever conscientemente: git commit --no-verify (e registrar).
cd "$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -f .claude/hooks/_integridade.sh ] || exit 0

if [ -n "${CLAUDECODE:-}${CLAUDE_CODE:-}" ]; then
  bash .claude/hooks/_integridade.sh --gravar >/dev/null 2>&1 && git add .claude/INTEGRIDADE.sha256
  exit 0
fi

TOCOU=$(git diff --cached --name-only | grep -E '^(CLAUDE\.md|\.mcp\.json|\.claude/|radar/|\.github/workflows/)' || true)
if [ -n "$TOCOU" ]; then
  echo "✗ SOBERANIA DO MOTOR: este commit altera arquivos do motor Claude Code fora do Claude Code:"
  echo "$TOCOU" | sed 's/^/    /'
  echo "  Codex/ChatGPT e edição manual podem LER e USAR o cérebro, nunca editar estes arquivos."
  echo "  Se foi você mesmo e é intencional: git commit --no-verify e registre em .claude/cerebro/02-MEMORIA.md."
  exit 1
fi
exit 0

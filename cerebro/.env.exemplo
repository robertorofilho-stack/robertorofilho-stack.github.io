# ============================================================
# Cerebro — modelo de .env. Copie para .env e preencha.
# O .env real NUNCA vai para o git (ja esta no .gitignore).
# ============================================================

# --- NOVO: publicacao (substitui o Higgsfield) ---
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# --- NOVO: texto (pesquisa, roteiro, legenda) ---
OPENROUTER_API_KEY=
# Opcional: trocar modelo sem mexer no codigo
# OPENROUTER_MODELO_PESQUISA=google/gemini-3.8-flash
# OPENROUTER_MODELO_ROTEIRO=anthropic/claude-sonnet-5
# OPENROUTER_MODELO_LEGENDA=anthropic/claude-sonnet-5
# OPENROUTER_MODELO_TRIVIAL=openai/gpt-5-nano

# --- JA EXISTENTES: nao apagar ---
# APIMART_API_KEY=      (video/voz + fallback de texto)
# FAL_KEY=              (video)
# ELEVENLABS_API_KEY=   (voz)
# HIGGSFIELD_API_KEY=   (DESATIVADO — manter a chave, nao usar)

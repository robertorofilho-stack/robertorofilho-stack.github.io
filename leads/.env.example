# Copie para .env (cp leads/.env.example leads/.env). O compose e o scrape.py leem o mesmo arquivo.
# Porta do scraper no seu computador (dentro do contêiner continua 8080).
SCRAPER_PORT=8080
# Deixe vazio para usar http://localhost:SCRAPER_PORT
SCRAPER_BASE_URL=
# Proxies para jobs grandes/repetidos (o scraper rotaciona). Separe por vírgula: http://user:senha@host:porta,socks5://host:porta
PROXIES=
